# =============================================================================
# SCORE backend · пример переменных окружения
# Скопируйте в `backend/env` (или `.env`) и заполните реальными значениями.
# =============================================================================

# --- База данных ------------------------------------------------------------
# Готовая строка подключения (Render / Neon) имеет приоритет.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Либо отдельные переменные (локальная разработка):
DB_NAME=nba
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- JWT (обязательно) ------------------------------------------------------
# Секрет берётся только из окружения: без него приложение не запустится (fail-closed).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- CORS -------------------------------------------------------------------
# Список разрешённых origins через запятую, без wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Окружение --------------------------------------------------------------
ENVIRONMENT=development

# --- Нейросеть --------------------------------------------------------------
MODEL_DIR=./models
